{
  "manifest_version": 3,
  "name": "Hireschema CV score",
  "version": "0.1.0",
  "description": "Score a CV against live India jobs. Talks only to the public Hireschema review API. Load unpacked from this folder in chrome://extensions.",
  "action": {
    "default_title": "Hireschema CV score",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://hireschema.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*",
        "https://naukri.com/*",
        "https://www.instahyre.com/*",
        "https://www.cutshort.io/*",
        "https://cutshort.io/*",
        "https://wellfound.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
